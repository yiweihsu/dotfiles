# Ghostty Configuration File

# Save this file to: ~/.config/ghostty/config

# Reload config while running: Cmd + Shift + ,

# --- Theme & Appearance ---

# Graphite Atelier: warm paper, mineral green, restrained ANSI accents.
background = #191c1d
foreground = #dedbd3
selection-background = #394443
selection-foreground = #f2eee5
palette = 0=#252a2b
palette = 1=#cf8b83
palette = 2=#a5b9a1
palette = 3=#c8b38a
palette = 4=#91aabb
palette = 5=#b3a1b8
palette = 6=#93b6b0
palette = 7=#dedbd3
palette = 8=#808b8b
palette = 9=#e2a098
palette = 10=#b8ccb3
palette = 11=#ddc79f
palette = 12=#a8c0d1
palette = 13=#c8b6cd
palette = 14=#acd0c9
palette = 15=#f2eee5

# A restrained native-glass look on macOS 26+.
background-opacity = 0.97
background-blur = macos-glass-regular
minimum-contrast = 1.2

# --- Fonts ---

font-family = JetBrainsMono Nerd Font Mono
# Traditional Chinese fallback keeps TC glyph forms and terminal cell widths.
font-family = Sarasa Mono TC
font-size = 14
font-feature = liga
font-feature = dlig
font-thicken = false
adjust-cell-height = 25%

# --- CJK (繁體中文) ---

# CJK Unified Ideographs
font-codepoint-map = U+4E00-U+9FFF=Sarasa Mono TC
# CJK Extension A
font-codepoint-map = U+3400-U+4DBF=Sarasa Mono TC
# CJK Compatibility Ideographs
font-codepoint-map = U+F900-U+FAFF=Sarasa Mono TC
# Bopomofo (注音)
font-codepoint-map = U+3100-U+312F=Sarasa Mono TC
# CJK Symbols and Punctuation (，。、「」等)
font-codepoint-map = U+3000-U+303F=Sarasa Mono TC
# Fullwidth Forms (全形英數符號)
font-codepoint-map = U+FF00-U+FFEF=Sarasa Mono TC
# Emoji
font-codepoint-map = U+1F000-U+1FAFF=Apple Color Emoji

# --- Window Behavior ---

# Unfocused split opacity

unfocused-split-opacity = 0.80
split-divider-color = #394443

# Hide title bar and borders

# You commented these out in your original file, so I kept them commented.

# If you want the "hacker look", uncomment the lines below:

macos-titlebar-style = tabs

# window-decoration = false

# Internal padding

window-padding-x = 20
window-padding-y = 16
window-padding-balance = true
window-padding-color = background

# Restore window state

window-save-state = always

# Shell integration powers prompt jumps, cwd-aware tabs/splits, and SSH terminfo fixes.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo,path

# Notify when a long command finishes while Ghostty is unfocused.
notify-on-command-finish = unfocused
notify-on-command-finish-after = 20s
notify-on-command-finish-action = notify,no-bell

# Enable window shadow (useful for Quake mode visibility)

macos-window-shadow = true

# --- Quake Mode (Global Hotkey) ---

# Global hotkey

keybind = global:alt+space=toggle_quick_terminal

# Quick terminal settings

quick-terminal-position = top
quick-terminal-size = 40%

# [CHANGED] Set to 'mouse' to make it appear on the current active monitor

quick-terminal-screen = mouse

quick-terminal-animation-duration = 0.14
quick-terminal-autohide = true
quick-terminal-space-behavior = move

# --- Cursor & Mouse ---

cursor-style = block
cursor-style-blink = false
cursor-color = #b8ccb3
cursor-opacity = 0.92
cursor-click-to-move = true
mouse-hide-while-typing = true

# A still cursor keeps the interface calm; the original shader remains on disk.

# --- Clipboard ---

copy-on-select = true

# --- Miscellaneous ---

confirm-close-surface = true

# Use Ghostty's retro variant in the Dock and app switcher.
macos-icon = retro

# Prevent accidental Cmd+Q quits; use Cmd+Option+Q when intentionally quitting.
keybind = cmd+q=ignore
keybind = cmd+alt+q=quit

keybind = cmd+shift+p=toggle_command_palette
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+f=write_scrollback_file:open
keybind = cmd+shift+i=prompt_surface_title
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1
keybind = cmd+ctrl+equal=equalize_splits
keybind = cmd+shift+r=reload_config

# Fix tab switching when CJK input method is active
keybind = cmd+shift+physical:left_bracket=previous_tab
keybind = cmd+shift+physical:right_bracket=next_tab
